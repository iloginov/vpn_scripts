# Скопируйте в ssh/hosts.env. Файл в git не входит.
# Это не inventory: скрипты делают source и читают переменные.

# Пара: exit.sh, затем entry.sh.
# Новая тройка, пока exit открыт: exit.sh --peer middle, middle.sh, entry.sh --uplink client_entry.conf.
# Exit из страны уже не открывается: insert-middle.sh.

EXIT_SSH=ubuntu@203.0.113.10
EXIT_SUBNET=10.10.1.0/24
EXIT_WAN=eth0
EXIT_NAME="Exit 3.1"

ENTRY_SSH=ubuntu@203.0.113.20
ENTRY_SUBNET=10.10.2.0/24
ENTRY_NAME="Russia 3.1"

MIDDLE_SSH=
MIDDLE_SUBNET=10.10.3.0/24
MIDDLE_NAME="Middle 3.1"

RU_EXIT_SSH=
RU_EXIT_SUBNET=10.10.4.0/24
RU_EXIT_WAN=eth0
RU_EXIT_NAME="RU exit 3.1"
RU_PEER=entry
